{
  "name": "agent-orchestrator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "test": "bun test",
    "images": "bun scripts/build-images.ts",
